# Copy this file to ".env" in the backend/ folder (never commit .env) and replace every CHANGE_ME.
# The app refuses to start until DATABASE_URL and JWT_SECRET hold real values.

# PostgreSQL connection string: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://cogniflow_user:CHANGE_ME@localhost:5432/cogniflow

# Secret used to sign JWTs. Must be >= 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value

ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:8501

# --- Optional: document pipeline ---
# MAX_UPLOAD_MB=10
# Full path to Tesseract if it is not on PATH (Windows default shown). Auto-detected when installed there.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_LANGUAGE=eng

# --- Optional: AI assistant (Google Gemini) ---
# Get a key at https://aistudio.google.com/ . Without a key the assistant still works in keyword mode.
# NEVER commit the real key. Put it only in your private backend/.env file.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_MAX_QUESTIONS_PER_HOUR=30

# Login rate limiting (optional; these are the defaults). After LOGIN_MAX_FAILURES failed logins for the same email
# from the same IP within LOGIN_WINDOW_MINUTES, further attempts are refused until the window has passed.
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15
